@article{bauermannFormationLiquidShells2023,
  title = {Formation of Liquid Shells in Active Droplet Systems},
  author = {Bauermann, Jonathan and Bartolucci, Giacomo and Boekhoven, Job and Weber, Christoph A. and J{\"u}licher, Frank},
